# Browser-visible testnet configuration (required, set before building on Vercel)
NEXT_PUBLIC_NEAR_CONTRACT_ID=scanmon-6f49a2b600.testnet
NEXT_PUBLIC_USDC_CONTRACT_ID=usdc.scanmon-6f49a2b600.testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_USDC_IS_MOCK=true

# Privy Google authentication. The app ID is public; the secret is server-only.
APP_ID_PRIVY=
APP_SECRET_PRIVY=
# Optional public app ID alias if APP_ID_PRIVY is not set
# NEXT_PUBLIC_PRIVY_APP_ID=

# Vercel server ONLY: restricted, low-balance testnet gas sponsor
NEAR_SPONSOR_ACCOUNT_ID=sponsor.scanmon-6f49a2b600.testnet
NEAR_SPONSOR_PRIVATE_KEY=

# Optional: higher history API quota; public access works without it
NEARBLOCKS_API_KEY=
# Optional: merchant dialogue; contract quotes work without AI providers
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# LOCAL DEPLOYMENT ONLY. Do not add these keys to Vercel.
NEAR_DEPLOYER_ACCOUNT_ID=scanmon-6f49a2b600.testnet
NEAR_DEPLOYER_PRIVATE_KEY=
NEAR_USDC_ACCOUNT_ID=usdc.scanmon-6f49a2b600.testnet
NEAR_USDC_PRIVATE_KEY=
NEAR_TOMO_ACCOUNT_ID=tomo.scanmon-6f49a2b600.testnet
NEAR_TOMO_PRIVATE_KEY=
NEAR_KOBAN_ACCOUNT_ID=koban.scanmon-6f49a2b600.testnet
NEAR_KOBAN_PRIVATE_KEY=

# Server-only Neon Postgres for atomic PvP room state (never NEXT_PUBLIC).
PVP_DATABASE_URL=
# PvP result proofs use NEAR_SPONSOR_PRIVATE_KEY. Configure its public key on-chain.
