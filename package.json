{
  "name": "scanmon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts src/lib/near/*.test.ts src/app/collection/*.test.ts src/app/market/*.test.ts src/app/battle/*.test.ts",
    "contract:build": "RUSTFLAGS='-C target-cpu=mvp' cargo build --manifest-path smartcontract/Cargo.toml --target wasm32-unknown-unknown --release",
    "contract:test": "cargo test --manifest-path smartcontract/Cargo.toml -p scanmon-game --lib",
    "contract:deploy": "node scripts/deploy-contracts.mjs",
    "test:integration": "node scripts/test-testnet.mjs"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@google/genai": "^3.3.0",
    "@near-wallet-selector/core": "^10.1.4",
    "@near-wallet-selector/here-wallet": "^10.1.4",
    "@near-wallet-selector/meteor-wallet": "^10.1.4",
    "@near-wallet-selector/modal-ui": "^10.1.4",
    "@near-wallet-selector/my-near-wallet": "^10.1.4",
    "@noble/hashes": "^2.4.0",
    "@privy-io/node": "^0.39.0",
    "@privy-io/react-auth": "^3.51.4",
    "@scure/base": "^2.4.0",
    "@solana-program/memo": "^0.10.0",
    "@solana-program/system": "^0.10.0",
    "@solana-program/token": "^0.9.0",
    "@solana/kit": "^5.5.1",
    "@zxing/browser": "latest",
    "@zxing/library": "latest",
    "motion": "^14.13.0",
    "near-api-js": "^6.5.1",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "@near-js/accounts": "2.5.1",
    "@near-js/crypto": "2.5.1",
    "@near-js/providers": "2.5.1",
    "@near-js/signers": "2.5.1",
    "@near-js/transactions": "2.5.1"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "prettier": "^3.10.1",
    "tsx": "latest",
    "typescript": "latest"
  },
  "overrides": {
    "base-x@3": "3.0.11",
    "bn.js@5": "5.2.5",
    "ws@8": "8.23.0",
    "abitype@1": "1.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
